generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"     // bisa diganti dengan "postgresql" atau "mysql"
  url      = env("DATABASE_URL")
}

// ==============================
// Enums
// ==============================
enum Role {
  ADMIN
  PENELITI
}

// ==============================
// Auth/User
// ==============================
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(PENELITI)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ==================== ENTITAS UTAMA ====================

model Product {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique @map("product_id")         // ID asli dari CSV (Product_ID)
  name             String   @map("name")
  category         String?
  brand            String?
  season           String?
  originalPrice    Float    @map("original_price")
  competitorPrice  Float?   @map("competitor_price")
  optimalDiscount  Float?   @map("optimal_discount")           // dari kolom "Optimal Discount"

  // Relasi
  metrics          ProductMetric?
  promotions       Promotion[]
  salesHistory     SalesHistory[]
  discountResults  DiscountResult[]

  @@map("products")
}

model ProductMetric {
  id                Int     @id @default(autoincrement())
  productId         Int     @unique @map("product_id")
  stockLevel        Int     @map("stock_level")                // dari Stock_Level
  seasonalityFactor Float   @map("seasonality_factor")         // dari Seasonality_Factor
  returnRate        Float   @map("return_rate")                // dari Return Rate
  customerRatings   Float   @map("customer_ratings")           // dari Customer Ratings

  // Relasi
  product           Product @relation(fields: [productId], references: [id])

  @@map("product_metrics")
}

model LoyaltyLevel {
  id        Int     @id @default(autoincrement())
  levelName String  @map("level_name")   // misal: Rendah, Sedang, Tinggi
  minValue  Float   @map("min_value")     // batas bawah nilai loyalitas
  maxValue  Float   @map("max_value")     // batas atas nilai loyalitas

  @@map("loyalty_levels")
}

model Promotion {
  id             Int       @id @default(autoincrement())
  productId      Int       @map("product_id")
  markdownValue  Float     @map("markdown_value")   // nilai diskon dari Markdown_1..4
  promotionType  String    @map("promotion_type")   // dari Promotion_Type
  markdownLevel  Int       @map("markdown_level")   // level markdown (1..4)
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")

  // Relasi
  product        Product   @relation(fields: [productId], references: [id])
  salesHistory   SalesHistory[]

  @@map("promotions")
}

model SalesHistory {
  id              Int       @id @default(autoincrement())
  productId       Int       @map("product_id")
  promotionId     Int?      @map("promotion_id")
  salesAmount     Float     @map("sales_amount")               // jumlah penjualan pada tahap tertentu
  stage           String    @map("stage")                      // 'historical', 'after_m1', 'after_m2', ...
  date            DateTime? @default(now())

  // Relasi
  product         Product   @relation(fields: [productId], references: [id])
  promotion       Promotion? @relation(fields: [promotionId], references: [id])

  @@map("sales_history")
}

// ==================== KONFIGURASI FUZZY LOGIC ====================

model FuzzyVariable {
  id          Int                @id @default(autoincrement())
  variableName String             @map("variable_name") // stok, permintaan, loyalitas, diskon
  variableType String             @map("variable_type")  // "input" atau "output"
  description  String?

  // Relasi
  membershipFunctions MembershipFunction[]

  @@map("fuzzy_variables")
}

model MembershipFunction {
  id           Int           @id @default(autoincrement())
  variableId   Int           @map("variable_id")
  label        String        // rendah, sedang, tinggi
  functionType String        @map("function_type") // "triangular", "trapezoidal", "gaussian"
  parameters   Json?         // parameter fungsi dalam format JSON, misal {a:0, b:40, c:70}
  minValue     Float?        @map("min_value")     // domain minimum (opsional)
  maxValue     Float?        @map("max_value")     // domain maksimum (opsional)

  // Relasi
  variable     FuzzyVariable @relation(fields: [variableId], references: [id])

  @@map("membership_functions")
}

model FuzzyRule {
  id       Int     @id @default(autoincrement())
  ruleText String  @map("rule_text") // contoh: "IF stok tinggi AND permintaan rendah THEN diskon besar"

  @@map("fuzzy_rules")
}

// ==================== HASIL PERHITUNGAN ====================

model DiscountResult {
  id                 Int      @id @default(autoincrement())
  productId          Int?     @map("product_id")
  inputValues        Json     @map("input_values")   // menyimpan nilai stok, permintaan, loyalitas
  calculatedDiscount Float    @map("calculated_discount")
  timestamp          DateTime @default(now())

  // Relasi
  product            Product? @relation(fields: [productId], references: [id])

  @@map("discount_results")
}